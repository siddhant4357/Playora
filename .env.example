# ─────────────────────────────────────────────────────────────────────────────
# Playora — Local Development Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:password@localhost:5432/ldxodoo?schema=public"

# JWT secret — generate with: openssl rand -base64 32
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"

# App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Gmail SMTP — for password reset emails
# Use a Gmail App Password (not your regular password)
# Guide: https://support.google.com/accounts/answer/185833
GMAIL_USER="your-gmail@gmail.com"
GMAIL_APP_PASSWORD="your-16-char-app-password"

# Twilio WhatsApp API
# Create a free trial account at twilio.com
# Go to WhatsApp Sandbox to get these keys
TWILIO_ACCOUNT_SID="ACxxxx..."
TWILIO_AUTH_TOKEN="your-auth-token..."
TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"

GROQ_API_KEY=""