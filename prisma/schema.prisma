// ─────────────────────────────────────────────────────────────────────────────
// Prisma Schema — Playora (sports club management)
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────────────────────
// ID CONVENTION (follow this for every model added in future phases):
//
//   id     String @id @default(cuid())   — primary, external-safe opaque ID
//                                          used in URLs, API responses, and
//                                          foreign-key relations. Never expose
//                                          hashId in URLs.
//
//   hashId Int    @unique @default(autoincrement())
//                                       — sequential numeric alias. Used for
//                                          display purposes only (e.g. "Order #42")
//                                          so humans can reference records without
//                                          leaking internal counts or insertion order
//                                          in security-sensitive contexts.
//
// Both fields are on every model. Do NOT use just one.
// ─────────────────────────────────────────────────────────────────────────────

// Roles are ordered roughly by authority. See lib/roles.ts for the
// route-access matrix and the post-login home of each role.
enum Role {
  OWNER
  MANAGER
  FRONT_DESK
  BAR_STAFF
  KITCHEN
  COACH
  MEMBER
}

// Club is the tenant. Every business record carries a clubId so the same
// kernel can run several clubs; for the hackathon there is exactly one.
model Club {
  id        String   @id @default(cuid())
  hashId    Int      @unique @default(autoincrement())

  name      String
  slug      String   @unique
  tagline   String?
  timezone  String   @default("Asia/Kolkata")
  currency  String   @default("INR")
  phone     String?
  email     String?
  address   String?

  // Opening hours used by slot generation (24h clock, club-local time)
  opensAt   String   @default("06:00")
  closesAt  String   @default("23:00")

  // Policy knobs: cancellation window, credit %, advance days, etc.
  settings  Json     @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users        User[]
  activityLogs ActivityLog[]
  plans        MembershipPlan[]
  members      Member[]
  courts       Court[]
  bookings     Booking[]
  waitlist     Waitlist[]
  transactions Transaction[]
  checkIns     CheckIn[]
  products     Product[]
  stockMoves   StockMovement[]
  orders       ShopOrder[]
  serviceJobs  ServiceJob[]
  tables       BarTable[]
  tabs         BarTab[]
  shifts       Shift[]
  leads        Lead[]
  invoices     Invoice[]
  payables     Payable[]
  reportShares ReportShare[]
  employees    Employee[]
  staffShifts  StaffShift[]
  attendance   Attendance[]
  leaves       LeaveRequest[]
  payrollRuns  PayrollRun[]

  @@map("clubs")
}

model User {
  id           String   @id @default(cuid())
  hashId       Int      @unique @default(autoincrement())

  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(MEMBER)
  phone        String?

  clubId       String
  club         Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)

  // Optional profile fields
  dob          DateTime?
  gender       String?

  // A MEMBER login points at its contact record. Staff users have none.
  memberId     String?  @unique
  member       Member?  @relation(fields: [memberId], references: [id], onDelete: SetNull)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  activityLogs        ActivityLog[]
  passwordResetTokens PasswordResetToken[]
  createdBookings     Booking[]     @relation("BookingCreatedBy")
  transactions        Transaction[]
  employee            Employee?

  @@index([clubId, role])
  @@map("users")
}

// ───────────────────────── Plans & Members ─────────────────────────

enum PlanTier {
  GOLD
  SILVER
  JUNIOR
}

model MembershipPlan {
  id                  String   @id @default(cuid())
  hashId              Int      @unique @default(autoincrement())
  clubId              String
  club                Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)

  tier                PlanTier
  name                String
  priceMonthly        Int      // paise
  priceYearly         Int      // paise
  courtDiscountPct    Int      @default(0) // 100 = free courts
  shopDiscountPct     Int      @default(0)
  barDiscountPct      Int      @default(0)
  maxBookingsPerDay   Int      @default(2)
  advanceBookingDays  Int      @default(7)
  guestPassesPerMonth Int      @default(0)
  benefits            String[] @default([])
  isActive            Boolean  @default(true)

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  members             Member[]

  @@unique([clubId, tier])
  @@map("membership_plans")
}

enum MemberStatus {
  LEAD
  TRIAL
  ACTIVE
  EXPIRED
  FROZEN
  CANCELLED
}

// Member is the single contact record (Odoo res.partner). Bookings,
// transactions, tabs and orders all hang off it.
model Member {
  id               String       @id @default(cuid())
  hashId           Int          @unique @default(autoincrement())
  clubId           String
  club             Club         @relation(fields: [clubId], references: [id], onDelete: Cascade)

  memberCode       String       @unique // CC-0001, printed on QR
  firstName        String
  lastName         String
  phone            String
  email            String?
  dateOfBirth      DateTime?
  gender           String?
  photoUrl         String?
  emergencyContact String?

  status           MemberStatus @default(LEAD)
  planId           String?
  plan             MembershipPlan? @relation(fields: [planId], references: [id], onDelete: SetNull)
  startDate        DateTime?
  expiryDate       DateTime?
  autoRenew        Boolean      @default(false)

  skillRating      Int          @default(3) // 1-5, for social play matchmaking
  notes            String?
  tags             String[]     @default([])
  qrToken          String       @unique @default(cuid())
  creditBalance    Int          @default(0) // paise, from cancellations

  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  user             User?
  bookings         Booking[]
  waitlist         Waitlist[]
  transactions     Transaction[]
  checkIns         CheckIn[]
  orders           ShopOrder[]
  serviceJobs      ServiceJob[]
  tabs             BarTab[]
  lead             Lead?
  memberNotes      MemberNote[]
  invoices         Invoice[]
  payables         Payable[]

  @@index([clubId, phone])
  @@index([clubId, status])
  @@map("members")
}

// ───────────────────────── Courts & Booking ─────────────────────────

enum CourtType {
  TENNIS
  CRICKET
  BADMINTON
  PADEL
  PICKLEBALL
}

enum CourtSurface {
  HARD
  CLAY
  GRASS
  SYNTHETIC
  INDOOR
}

model Court {
  id        String       @id @default(cuid())
  hashId    Int          @unique @default(autoincrement())
  clubId    String
  club      Club         @relation(fields: [clubId], references: [id], onDelete: Cascade)

  name      String // "Court 1"
  type      CourtType
  surface   CourtSurface?
  isIndoor  Boolean      @default(false)
  hasLights Boolean      @default(true)
  capacity  Int          @default(4)
  sortOrder Int          @default(0)
  isActive  Boolean      @default(true)

  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  pricing   CourtPricing[]
  bookings  Booking[]
  waitlist  Waitlist[]

  @@index([clubId, isActive])
  @@map("courts")
}

enum DayType {
  WEEKDAY
  WEEKEND
}

// Hour band × day type → walk-in price. Plan discounts apply on top.
model CourtPricing {
  id          String  @id @default(cuid())
  courtId     String
  court       Court   @relation(fields: [courtId], references: [id], onDelete: Cascade)

  dayType     DayType
  startHour   Int     // inclusive, 0-23
  endHour     Int     // exclusive, 1-24
  walkInPrice Int     // paise per 60-minute session
  label       String  // "Off-peak" / "Peak"

  @@index([courtId, dayType])
  @@map("court_pricing")
}

enum BookingKind {
  PRIVATE
  SOCIAL
  COACHING
  MAINTENANCE
  TRIAL
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
  NO_SHOW
  COMPLETED
}

enum BookingSource {
  WEB
  APP
  FRONT_DESK
  PHONE
  WHATSAPP
}

// Overlap safety is enforced by the Postgres exclusion constraint
// `booking_no_overlap` (see migration), not only by application code.
model Booking {
  id            String        @id @default(cuid())
  hashId        Int           @unique @default(autoincrement())
  clubId        String
  club          Club          @relation(fields: [clubId], references: [id], onDelete: Cascade)
  courtId       String
  court         Court         @relation(fields: [courtId], references: [id], onDelete: Restrict)

  memberId      String?       // null for walk-in
  member        Member?       @relation(fields: [memberId], references: [id], onDelete: SetNull)
  walkInName    String?
  walkInPhone   String?

  startsAt      DateTime
  endsAt        DateTime      // startsAt + 60 min
  kind          BookingKind   @default(PRIVATE)
  status        BookingStatus @default(CONFIRMED)
  source        BookingSource @default(WEB)

  listPrice     Int           // paise, before plan discount
  discountPct   Int           @default(0)
  priceCharged  Int           // paise after discount
  priceReason   String?       // "Gold plan — free courts"
  transactionId String?       @unique
  transaction   Transaction?  @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  checkedInAt   DateTime?
  cancelledAt   DateTime?
  cancelReason  String?
  creditIssued  Int           @default(0) // paise returned to member.creditBalance on cancel

  createdById   String?
  createdBy     User?         @relation("BookingCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([clubId, startsAt])
  @@index([courtId, startsAt])
  @@index([memberId, startsAt])
  @@map("bookings")
}

enum WaitlistStatus {
  WAITING
  OFFERED
  CONFIRMED
  EXPIRED
  CANCELLED
}

model Waitlist {
  id        String         @id @default(cuid())
  clubId    String
  club      Club           @relation(fields: [clubId], references: [id], onDelete: Cascade)
  courtId   String
  court     Court          @relation(fields: [courtId], references: [id], onDelete: Cascade)
  memberId  String
  member    Member         @relation(fields: [memberId], references: [id], onDelete: Cascade)

  startsAt  DateTime
  status    WaitlistStatus @default(WAITING)
  offeredAt DateTime?
  expiresAt DateTime?
  createdAt DateTime       @default(now())

  @@unique([courtId, startsAt, memberId])
  @@index([clubId, startsAt, status])
  @@map("waitlist")
}

// ───────────────────────── Money (single ledger) ─────────────────────────

enum PaymentMode {
  CASH
  CARD
  UPI
  ONLINE
  CREDIT
  COMPLIMENTARY
}

enum TxSource {
  COURT
  SHOP
  BAR
  MEMBERSHIP
  COACHING
  EVENT
  CORPORATE
  REFUND
  PAYROLL
  SUPPLIER
  OTHER
}

enum TxDirection {
  IN
  OUT
}

// Every rupee in or out of the club lands here, whatever module made it.
model Transaction {
  id          String      @id @default(cuid())
  hashId      Int         @unique @default(autoincrement())
  clubId      String
  club        Club        @relation(fields: [clubId], references: [id], onDelete: Cascade)
  memberId    String?
  member      Member?     @relation(fields: [memberId], references: [id], onDelete: SetNull)

  source      TxSource
  direction   TxDirection @default(IN)
  amount      Int         // paise, gross
  tax         Int         @default(0)
  paymentMode PaymentMode
  reference   String?     // UPI txn id, card last4
  refType     String?     // Booking | ShopOrder | BarTab | Invoice
  refId       String?
  description String

  byUserId    String?
  byUser      User?       @relation(fields: [byUserId], references: [id], onDelete: SetNull)
  createdAt   DateTime    @default(now())

  booking     Booking?
  invoice     Invoice?
  payable     Payable?
  payrollRun  PayrollRun?

  @@index([clubId, createdAt])
  @@index([clubId, source])
  @@map("transactions")
}

// ActivityLog: lightweight audit trail.
// Tracks WHO did WHAT to WHICH entity and WHEN.
// Old/new state stored as Json blobs for diff rendering.
// Replaces a full Prometheus/Grafana observability stack as a scope decision
// for the hackathon — the /admin/health page consumes this table directly.
model ActivityLog {
  id        String   @id @default(cuid())
  hashId    Int      @unique @default(autoincrement())

  // What happened (e.g. "USER_SIGNUP", "USER_LOGIN", "RECORD_CREATED")
  action    String

  // The type of resource affected (e.g. "User", "Product", "SaleOrder")
  entity    String

  // The cuid() of the affected record; nullable for system-level events
  entityId  String?

  // JSON snapshots of state before and after the action
  oldData   Json?
  newData   Json?

  // Request metadata for security audit
  ipAddress String?
  userAgent String?

  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  clubId    String?
  club      Club?    @relation(fields: [clubId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([clubId, createdAt])
  @@index([userId])
  @@index([entity, entityId])
  @@index([createdAt])
  @@map("activity_logs")
}

// ───────────────────────── Members: check-ins & notes ─────────────────────────

model CheckIn {
  id        String   @id @default(cuid())
  hashId    Int      @unique @default(autoincrement())
  clubId    String
  club      Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  memberId  String
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  method    String   @default("QR") // QR | MANUAL
  byUserId  String?
  createdAt DateTime @default(now())

  @@index([clubId, createdAt])
  @@index([memberId, createdAt])
  @@map("check_ins")
}

model MemberNote {
  id        String   @id @default(cuid())
  memberId  String
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  content   String
  byUserId  String?
  createdAt DateTime @default(now())

  @@index([memberId, createdAt])
  @@map("member_notes")
}

// ───────────────────────���─ Shop & inventory ─────────────────────────

enum ProductCategory {
  RACKET
  BALL
  SHOES
  ACCESSORY
  APPAREL
  SERVICE
  FOOD
  BEVERAGE
}

// Single product row backs the counter, the online shop AND the bar menu.
// stockQty is the one source of truth; every change goes through StockMovement.
model Product {
  id          String          @id @default(cuid())
  hashId      Int             @unique @default(autoincrement())
  clubId      String
  club        Club            @relation(fields: [clubId], references: [id], onDelete: Cascade)

  sku         String          @unique
  name        String
  description String?
  category    ProductCategory
  price       Int             // paise
  costPrice   Int?
  taxRatePct  Int             @default(18)
  imageUrl    String?

  isForBar    Boolean         @default(false)
  isForShop   Boolean         @default(true)
  isService   Boolean         @default(false)
  isAvailable Boolean         @default(true) // bar "86'd" toggle
  trackStock  Boolean         @default(true)
  stockQty    Int             @default(0)
  lowStockAt  Int             @default(5)
  isActive    Boolean         @default(true)

  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  movements   StockMovement[]
  orderItems  ShopOrderItem[]
  tabItems    BarTabItem[]

  @@index([clubId, category])
  @@index([clubId, isForBar])
  @@map("products")
}

model StockMovement {
  id        String   @id @default(cuid())
  hashId    Int      @unique @default(autoincrement())
  clubId    String
  club      Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  delta     Int      // +10 restock, -1 sale
  reason    String   // SALE | RESTOCK | ADJUSTMENT | RETURN | WASTAGE
  refType   String?  // ShopOrder | BarTab
  refId     String?
  note      String?
  byUserId  String?
  createdAt DateTime @default(now())

  @@index([productId, createdAt])
  @@index([clubId, createdAt])
  @@map("stock_movements")
}

enum OrderChannel {
  COUNTER
  ONLINE
}

enum Fulfilment {
  TAKEAWAY
  CLICK_COLLECT
  DELIVERY
}

enum OrderStatus {
  PENDING
  PAID
  PREPARING
  READY_FOR_PICKUP
  OUT_FOR_DELIVERY
  COMPLETED
  CANCELLED
}

model ShopOrder {
  id              String          @id @default(cuid())
  hashId          Int             @unique @default(autoincrement())
  clubId          String
  club            Club            @relation(fields: [clubId], references: [id], onDelete: Cascade)
  orderNo         String          @unique
  memberId        String?
  member          Member?         @relation(fields: [memberId], references: [id], onDelete: SetNull)
  guestName       String?
  guestPhone      String?
  guestEmail      String?
  channel         OrderChannel
  fulfilment      Fulfilment      @default(TAKEAWAY)
  deliveryAddress String?
  status          OrderStatus     @default(PENDING)
  subtotal        Int
  discountPct     Int             @default(0)
  discount        Int             @default(0)
  tax             Int
  total           Int
  paymentMode     PaymentMode?
  transactionId   String?         @unique
  notes           String?
  byUserId        String?
  items           ShopOrderItem[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([clubId, status])
  @@index([clubId, createdAt])
  @@map("shop_orders")
}

model ShopOrderItem {
  id        String    @id @default(cuid())
  orderId   String
  order     ShopOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  name      String
  qty       Int
  unitPrice Int
  total     Int

  @@map("shop_order_items")
}

enum ServiceJobStatus {
  RECEIVED
  IN_PROGRESS
  READY
  COLLECTED
}

// Restringing and other workshop jobs.
model ServiceJob {
  id           String           @id @default(cuid())
  hashId       Int              @unique @default(autoincrement())
  clubId       String
  club         Club             @relation(fields: [clubId], references: [id], onDelete: Cascade)
  jobNo        String           @unique
  memberId     String?
  member       Member?          @relation(fields: [memberId], references: [id], onDelete: SetNull)
  customerName String
  phone        String
  item         String           // "Wilson Pro Staff — 24 lbs"
  service      String           // "Restring"
  price        Int
  status       ServiceJobStatus @default(RECEIVED)
  dueAt        DateTime
  readyAt      DateTime?
  collectedAt  DateTime?
  notes        String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([clubId, status])
  @@map("service_jobs")
}

// ───────────────────────── Bar & cafeteria ─────────────────────────

model BarTable {
  id        String   @id @default(cuid())
  hashId    Int      @unique @default(autoincrement())
  clubId    String
  club      Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  name      String   // "T1", "Patio 3"
  zone      String   @default("Indoor") // Indoor | Patio | Court-side
  seats     Int      @default(4)
  qrToken   String   @unique @default(cuid())
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)

  tabs      BarTab[]

  @@index([clubId, zone])
  @@map("bar_tables")
}

enum TabStatus {
  OPEN
  SETTLED
  VOID
}

model BarTab {
  id          String       @id @default(cuid())
  hashId      Int          @unique @default(autoincrement())
  clubId      String
  club        Club         @relation(fields: [clubId], references: [id], onDelete: Cascade)
  tabNo       String       @unique
  tableId     String?
  table       BarTable?    @relation(fields: [tableId], references: [id], onDelete: SetNull)
  memberId    String?
  member      Member?      @relation(fields: [memberId], references: [id], onDelete: SetNull)
  guestName   String?
  guestPhone  String?
  source      String       @default("POS") // POS | QR
  status      TabStatus    @default(OPEN)
  openedById  String?
  openedAt    DateTime     @default(now())
  settledAt   DateTime?
  discountPct Int          @default(0)
  subtotal    Int          @default(0)
  discount    Int          @default(0)
  tax         Int          @default(0)
  total       Int          @default(0)
  voidReason  String?
  shiftId     String?
  shift       Shift?       @relation(fields: [shiftId], references: [id], onDelete: SetNull)

  items       BarTabItem[]
  payments    Payment[]

  @@index([clubId, status])
  @@index([clubId, openedAt])
  @@map("bar_tabs")
}

enum KitchenStatus {
  NEW
  PREPARING
  READY
  SERVED
  CANCELLED
}

model BarTabItem {
  id              String        @id @default(cuid())
  hashId          Int           @unique @default(autoincrement())
  tabId           String
  tab             BarTab        @relation(fields: [tabId], references: [id], onDelete: Cascade)
  productId       String
  product         Product       @relation(fields: [productId], references: [id], onDelete: Restrict)
  name            String
  qty             Int
  unitPrice       Int
  modifiers       String[]      @default([])
  notes           String?
  needsKitchen    Boolean       @default(true) // FOOD → kitchen; BEVERAGE served at bar
  kitchenStatus   KitchenStatus @default(NEW)
  sentToKitchenAt DateTime      @default(now())
  readyAt         DateTime?
  servedAt        DateTime?
  voidReason      String?

  @@index([tabId])
  @@index([kitchenStatus, sentToKitchenAt])
  @@map("bar_tab_items")
}

// Split payments on a tab. Each row also lands in Transaction when the tab settles.
model Payment {
  id        String      @id @default(cuid())
  tabId     String
  tab       BarTab      @relation(fields: [tabId], references: [id], onDelete: Cascade)
  mode      PaymentMode
  amount    Int
  reference String?
  byUserId  String?
  createdAt DateTime    @default(now())

  @@map("payments")
}

// A bar shift: clock in with opening cash, close with counted cash → Z-report.
model Shift {
  id          String    @id @default(cuid())
  hashId      Int       @unique @default(autoincrement())
  clubId      String
  club        Club      @relation(fields: [clubId], references: [id], onDelete: Cascade)
  area        String    @default("BAR")
  openedById  String
  openedByName String
  startsAt    DateTime  @default(now())
  endsAt      DateTime?
  openingCash Int       @default(0)
  closingCash Int?
  expectedCash Int?
  notes       String?
  report      Json?     // frozen Z-report snapshot at close

  tabs        BarTab[]

  @@index([clubId, startsAt])
  @@map("shifts")
}

// ───────────────────────── Leads / CRM ─────────────────────────

enum LeadStage {
  NEW
  CONTACTED
  QUOTE_SENT
  TRIAL_BOOKED
  CONVERTED
  LOST
}

model Lead {
  id           String         @id @default(cuid())
  hashId       Int            @unique @default(autoincrement())
  clubId       String
  club         Club           @relation(fields: [clubId], references: [id], onDelete: Cascade)
  memberId     String?        @unique
  member       Member?        @relation(fields: [memberId], references: [id], onDelete: SetNull)

  name         String
  phone        String
  email        String?
  interest     String?        // Tennis, Padel, Membership, Coaching
  source       String         @default("WEBSITE") // WEBSITE | WALK_IN | PHONE | WHATSAPP | REFERRAL | INSTAGRAM
  stage        LeadStage      @default(NEW)
  message      String?
  assignedToId String?
  nextFollowUp DateTime?
  lostReason   String?

  quotePlanId  String?
  quoteBilling String?        // MONTHLY | YEARLY
  quoteAmount  Int?
  quoteSentAt  DateTime?
  trialBookingId String?      @unique

  activities   LeadActivity[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([clubId, stage])
  @@index([clubId, nextFollowUp])
  @@map("leads")
}

model LeadActivity {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type      String   // NOTE | CALL | WHATSAPP | EMAIL | QUOTE | STAGE_CHANGE | TRIAL
  content   String
  byUserId  String?
  createdAt DateTime @default(now())

  @@index([leadId, createdAt])
  @@map("lead_activities")
}

// ───────────────────────── Finance ─────────────────────────

enum InvoiceKind {
  MEMBERSHIP
  CORPORATE
  OTHER
}

enum InvoiceStatus {
  ISSUED
  PAID
  VOID
}

// Receivables. Paying an invoice posts exactly one IN Transaction; the
// dashboard never reads invoices for revenue, only the ledger.
model Invoice {
  id            String        @id @default(cuid())
  hashId        Int           @unique @default(autoincrement())
  clubId        String
  club          Club          @relation(fields: [clubId], references: [id], onDelete: Cascade)
  invoiceNo     String        @unique
  kind          InvoiceKind
  status        InvoiceStatus @default(ISSUED)

  memberId      String?
  member        Member?       @relation(fields: [memberId], references: [id], onDelete: SetNull)
  billToName    String
  billToEmail   String?
  billToPhone   String?
  billToAddress String?
  billToGstin   String?

  issueDate     DateTime      @default(now())
  dueDate       DateTime
  subtotal      Int           // paise, ex-tax
  tax           Int
  total         Int
  notes         String?

  paidAt        DateTime?
  paymentMode   PaymentMode?
  transactionId String?       @unique
  transaction   Transaction?  @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  voidReason    String?

  items         InvoiceItem[]
  createdById   String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([clubId, status])
  @@index([clubId, issueDate])
  @@map("invoices")
}

model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  qty         Int
  unitPrice   Int     // paise, ex-tax
  taxRatePct  Int
  amount      Int     // qty * unitPrice
  tax         Int
  sortOrder   Int     @default(0)

  @@index([invoiceId])
  @@map("invoice_items")
}

enum PayableKind {
  SUPPLIER
  SALARY
  REFUND
  TAX
  OTHER
}

enum PayableStatus {
  PENDING
  PAID
  VOID
}

// "What do we owe?" Paying one posts exactly one OUT Transaction.
model Payable {
  id            String        @id @default(cuid())
  hashId        Int           @unique @default(autoincrement())
  clubId        String
  club          Club          @relation(fields: [clubId], references: [id], onDelete: Cascade)
  kind          PayableKind
  status        PayableStatus @default(PENDING)
  payee         String
  description   String
  reference     String?       // supplier bill no, payroll month
  amount        Int           // paise
  dueDate       DateTime

  memberId      String?
  member        Member?       @relation(fields: [memberId], references: [id], onDelete: SetNull)

  paidAt        DateTime?
  paymentMode   PaymentMode?
  transactionId String?       @unique
  transaction   Transaction?  @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  createdById   String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([clubId, status, dueDate])
  @@map("payables")
}

// Read-only shareable report links (owner → accountant / partner).
model ReportShare {
  id        String   @id @default(cuid())
  clubId    String
  club      Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  token     String   @unique @default(cuid())
  label     String
  period    String   // "month" | "week" | "today"
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([token])
  @@map("report_shares")
}

// ───────────────────────── HR (Phase 7) ─────────────────────────
// One Employee per staff login. Salary is monthly paise; rota rows are
// planned shifts, Attendance rows are actual clock in/out. Payroll freezes
// the month into Payslips and posts a single PAYROLL OUT to the ledger.

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
}

enum LeaveType {
  CASUAL
  SICK
  EARNED
  UNPAID
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum PayrollStatus {
  DRAFT
  APPROVED
  PAID
}

model Employee {
  id             String         @id @default(cuid())
  hashId         Int            @unique @default(autoincrement())
  clubId         String
  club           Club           @relation(fields: [clubId], references: [id], onDelete: Cascade)
  userId         String         @unique
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  employeeNo     String
  designation    String
  department     String         // "Front desk" | "Bar" | "Kitchen" | "Coaching" | "Management"
  employmentType EmploymentType @default(FULL_TIME)
  joinedOn       DateTime
  leftOn         DateTime?

  monthlySalary  Int            // paise
  hourlyRate     Int?           // paise; used for PART_TIME overtime
  leaveBalance   Int            @default(12) // days remaining this year
  bankAccount    String?
  ifsc           String?
  pan            String?

  shifts         StaffShift[]
  attendance     Attendance[]
  leaves         LeaveRequest[]
  payslips       Payslip[]

  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@unique([clubId, employeeNo])
  @@index([clubId, department])
  @@map("employees")
}

model StaffShift {
  id         String   @id @default(cuid())
  clubId     String
  club       Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date       String   // YYYY-MM-DD club-local
  startMin   Int      // minutes from midnight
  endMin     Int
  area       String   // "Front desk" | "Bar" | "Kitchen" | "Courts"
  notes      String?
  createdAt  DateTime @default(now())

  @@unique([employeeId, date, startMin])
  @@index([clubId, date])
  @@map("staff_shifts")
}

model Attendance {
  id         String    @id @default(cuid())
  clubId     String
  club       Club      @relation(fields: [clubId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date       String    // YYYY-MM-DD club-local
  clockIn    DateTime
  clockOut   DateTime?
  minutes    Int?      // computed at clock-out
  source     String    @default("DESK") // DESK | QR | MANUAL
  createdAt  DateTime  @default(now())

  @@index([clubId, date])
  @@index([employeeId, date])
  @@map("attendance")
}

model LeaveRequest {
  id           String      @id @default(cuid())
  hashId       Int         @unique @default(autoincrement())
  clubId       String
  club         Club        @relation(fields: [clubId], references: [id], onDelete: Cascade)
  employeeId   String
  employee     Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type         LeaveType
  fromDate     String      // YYYY-MM-DD
  toDate       String
  days         Int
  reason       String?
  status       LeaveStatus @default(PENDING)
  decidedById  String?
  decidedAt    DateTime?
  decisionNote String?
  createdAt    DateTime    @default(now())

  @@index([clubId, status])
  @@index([employeeId, fromDate])
  @@map("leave_requests")
}

model PayrollRun {
  id            String        @id @default(cuid())
  hashId        Int           @unique @default(autoincrement())
  clubId        String
  club          Club          @relation(fields: [clubId], references: [id], onDelete: Cascade)
  period        String        // YYYY-MM
  status        PayrollStatus @default(DRAFT)
  gross         Int
  deductions    Int
  net           Int
  headcount     Int
  approvedById  String?
  approvedAt    DateTime?
  paidAt        DateTime?
  paymentMode   PaymentMode?
  transactionId String?       @unique
  transaction   Transaction?  @relation(fields: [transactionId], references: [id])
  payslips      Payslip[]
  createdById   String
  createdAt     DateTime      @default(now())

  @@unique([clubId, period])
  @@map("payroll_runs")
}

model Payslip {
  id            String     @id @default(cuid())
  hashId        Int        @unique @default(autoincrement())
  runId         String
  run           PayrollRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  employeeId    String
  employee      Employee   @relation(fields: [employeeId], references: [id])
  slipNo        String
  daysInMonth   Int
  daysWorked    Int
  paidLeaveDays Int
  unpaidDays    Int
  overtimeMin   Int        @default(0)
  basic         Int        // paise, pro-rated
  overtime      Int        @default(0)
  gross         Int
  pf            Int        @default(0)
  tds           Int        @default(0)
  deductions    Int
  net           Int
  createdAt     DateTime   @default(now())

  @@unique([runId, employeeId])
  @@map("payslips")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([token])
  @@index([userId])
  @@map("password_reset_tokens")
}
